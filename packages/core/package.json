{
  "name": "@askskip/core",
  "type": "module",
  "version": "0.2.0",
  "description": "Skip Client Open App shared foundation — config + API-key resolver, Skip AI Agent / component-registry record helpers, and the in-process install (setup) / uninstall (teardown) hooks referenced by the app manifest. Deliberately light (core + credentials only) so install hooks run without the runtime package's heavy dependencies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./teardown": {
      "types": "./dist/teardown.d.ts",
      "default": "./dist/teardown.js"
    }
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "BlueCypress",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlueCypress/Skip-Client-Open-App"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@memberjunction/core": "^6.1.0-edge.4",
    "@memberjunction/credentials": "^6.1.0-edge.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
