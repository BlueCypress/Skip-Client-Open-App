{
  "name": "@askskip/server",
  "type": "module",
  "version": "0.3.0",
  "description": "Skip Client Open App server (runtime) package — SkipProxyAgent, SkipSDK, scoped callback-key provisioner, and server middleware. Loads only on MJ instances that install the Skip Client Open App.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "BlueCypress",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlueCypress/Skip-Client-Open-App"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@askskip/core": "0.3.0",
    "@askskip/types": "0.3.0",
    "mssql": "^11.0.1",
    "rxjs": "^7.8.1"
  },
  "peerDependencies": {
    "@memberjunction/ai": "^6.1.0-edge.6",
    "@memberjunction/ai-agents": "^6.1.0-edge.6",
    "@memberjunction/ai-core-plus": "^6.1.0-edge.6",
    "@memberjunction/aiengine": "^6.1.0-edge.6",
    "@memberjunction/api-keys": "^6.1.0-edge.6",
    "@memberjunction/core": "^6.1.0-edge.6",
    "@memberjunction/core-entities": "^6.1.0-edge.6",
    "@memberjunction/core-entities-server": "^6.1.0-edge.6",
    "@memberjunction/data-context": "^6.1.0-edge.6",
    "@memberjunction/generic-database-provider": "^6.1.0-edge.6",
    "@memberjunction/global": "^6.1.0-edge.6",
    "@memberjunction/interactive-component-types": "^6.1.0-edge.6",
    "@memberjunction/server": "^6.1.0-edge.6",
    "@memberjunction/sql-dialect": "^6.1.0-edge.6",
    "@memberjunction/sql-parser": "^6.1.0-edge.6",
    "@memberjunction/sqlserver-dataprovider": "^6.1.0-edge.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
